<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="vertical" android:background="#F014181F">

    <LinearLayout
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:paddingLeft="10dp" android:paddingRight="10dp" android:paddingTop="8dp">

        <EditText android:id="@+id/etParseUrl"
            android:layout_width="0dp" android:layout_height="40dp" android:layout_weight="1"
            android:background="@drawable/bg_input"
            android:hint="粘贴抖音/B站链接或房间号"
            android:paddingLeft="12dp" android:paddingRight="12dp"
            android:textSize="13sp"
            android:imeOptions="actionGo"
            android:inputType="textUri" android:maxLines="1"/>
        <TextView android:id="@+id/btnParseGo" style="@style/Chip"
            android:layout_width="wrap_content"
            android:text="解析"/>
        <TextView android:id="@+id/btnParseUA" style="@style/Chip"
            android:layout_width="wrap_content"
            android:text="UA:手机"/>
    </LinearLayout>

    <LinearLayout android:id="@+id/parseList"
        android:layout_width="match_parent" android:layout_height="240dp"
        android:orientation="vertical"
        android:paddingTop="4dp" android:paddingBottom="6dp"
        android:scrollbars="vertical"/>

</LinearLayout>

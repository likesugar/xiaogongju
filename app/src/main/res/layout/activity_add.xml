<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg">

    <!-- 顶部蓝条 -->
    <LinearLayout
        android:layout_width="match_parent" android:layout_height="56dp"
        android:background="@color/blue2"
        android:gravity="center_vertical"
        android:paddingLeft="8dp" android:paddingRight="16dp">

        <TextView android:id="@+id/btnBack"
            android:layout_width="40dp" android:layout_height="match_parent"
            android:text="‹" android:textColor="#FFFFFF"
            android:textSize="26sp" android:gravity="center"/>

        <TextView
            android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="新增用药计划" android:textColor="#FFFFFF"
            android:textSize="18sp" android:textStyle="bold"
            android:gravity="center"/>
        <View android:layout_width="40dp" android:layout_height="1dp"/>
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_weight="1" android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingLeft="14dp" android:paddingRight="14dp"
            android:paddingTop="14dp" android:paddingBottom="14dp">

            <LinearLayout
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:background="@drawable/bg_card"
                android:orientation="vertical"
                android:paddingLeft="18dp" android:paddingRight="18dp"
                android:paddingBottom="6dp">

                <!-- 药品名称 -->
                <LinearLayout style="@style/FormRow">
                    <TextView style="@style/FormIcon" android:text="💊"/>
                    <TextView style="@style/FormLabel" android:text="药品名称"/>
                    <EditText android:id="@+id/etName" style="@style/FormEdit"
                        android:hint="请输入药品名称"/>
                </LinearLayout>
                <View style="@style/FormDivider"/>

                <!-- 规格剂量 -->
                <LinearLayout style="@style/FormRow">
                    <TextView style="@style/FormIcon" android:text="🧴"/>
                    <TextView style="@style/FormLabel" android:text="规格剂量"/>
                    <EditText android:id="@+id/etSpec" style="@style/FormEdit"
                        android:hint="如：10mg*12片/盒"/>
                </LinearLayout>
                <View style="@style/FormDivider"/>

                <!-- 单次用量 -->
                <LinearLayout style="@style/FormRow">
                    <TextView style="@style/FormIcon" android:text="🥛"/>
                    <TextView style="@style/FormLabel" android:text="单次用量"/>
                    <EditText android:id="@+id/etDose" style="@style/FormEdit"
                        android:layout_weight="0" android:layout_width="90dp"
                        android:hint="数量" android:text="1"
                        android:inputType="number"/>
                    <TextView android:id="@+id/unitPill" style="@style/Chip" android:text="片"/>
                    <TextView android:id="@+id/unitGran" style="@style/Chip" android:text="粒"
                        android:layout_marginLeft="8dp"/>
                </LinearLayout>
                <View style="@style/FormDivider"/>

                <!-- 服用时间 -->
                <LinearLayout
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="vertical" android:paddingTop="14dp" android:paddingBottom="10dp">

                    <LinearLayout
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="horizontal">
                        <TextView style="@style/FormIcon" android:text="⏰"/>
                        <TextView style="@style/FormLabel" android:text="服用时间"/>
                    </LinearLayout>

                    <LinearLayout android:id="@+id/timeChips"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:layout_marginTop="10dp" android:layout_marginLeft="34dp"
                        android:orientation="horizontal" android:gravity="center_vertical"/>
                </LinearLayout>
                <View style="@style/FormDivider"/>

                <!-- 服药关系 -->
                <LinearLayout style="@style/FormRow" android:paddingTop="12dp" android:paddingBottom="12dp">
                    <TextView style="@style/FormIcon" android:text="🍽️"/>
                    <TextView style="@style/FormLabel" android:text="服药关系"/>
                    <TextView android:id="@+id/relBefore" style="@style/Chip"
                        android:layout_marginLeft="10dp" android:text="饭前"/>
                    <TextView android:id="@+id/relAfter" style="@style/Chip"
                        android:layout_marginLeft="8dp" android:text="饭后"/>
                    <TextView android:id="@+id/relSleep" style="@style/Chip"
                        android:layout_marginLeft="8dp" android:text="睡前"/>
                </LinearLayout>
                <View style="@style/FormDivider"/>

                <!-- 重复周期 -->
                <LinearLayout style="@style/FormRow" android:paddingTop="12dp" android:paddingBottom="12dp">
                    <TextView style="@style/FormIcon" android:text="🔁"/>
                    <TextView style="@style/FormLabel" android:text="重复周期"/>
                    <TextView android:id="@+id/rpDaily" style="@style/Chip"
                        android:layout_marginLeft="10dp" android:text="每天"/>
                    <TextView android:id="@+id/rpWork" style="@style/Chip"
                        android:layout_marginLeft="8dp" android:text="工作日"/>
                    <TextView android:id="@+id/rpCustom" style="@style/Chip"
                        android:layout_marginLeft="8dp" android:text="自定义"/>
                </LinearLayout>

                <!-- 自定义星期选择 -->
                <LinearLayout android:id="@+id/weekdayRow"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:visibility="gone"
                    android:layout_marginLeft="34dp" android:layout_marginBottom="12dp">
                    <TextView android:id="@+id/wd1"
                        android:layout_width="34dp" android:layout_height="34dp"
                        android:background="@drawable/bg_chip_off" android:text="一"
                        android:textSize="13sp" android:textColor="#6B7280" android:gravity="center"/>
                    <TextView android:id="@+id/wd2"
                        android:layout_width="34dp" android:layout_height="34dp"
                        android:layout_marginLeft="6dp"
                        android:background="@drawable/bg_chip_off" android:text="二"
                        android:textSize="13sp" android:textColor="#6B7280" android:gravity="center"/>
                    <TextView android:id="@+id/wd3"
                        android:layout_width="34dp" android:layout_height="34dp"
                        android:layout_marginLeft="6dp"
                        android:background="@drawable/bg_chip_off" android:text="三"
                        android:textSize="13sp" android:textColor="#6B7280" android:gravity="center"/>
                    <TextView android:id="@+id/wd4"
                        android:layout_width="34dp" android:layout_height="34dp"
                        android:layout_marginLeft="6dp"
                        android:background="@drawable/bg_chip_off" android:text="四"
                        android:textSize="13sp" android:textColor="#6B7280" android:gravity="center"/>
                    <TextView android:id="@+id/wd5"
                        android:layout_width="34dp" android:layout_height="34dp"
                        android:layout_marginLeft="6dp"
                        android:background="@drawable/bg_chip_off" android:text="五"
                        android:textSize="13sp" android:textColor="#6B7280" android:gravity="center"/>
                    <TextView android:id="@+id/wd6"
                        android:layout_width="34dp" android:layout_height="34dp"
                        android:layout_marginLeft="6dp"
                        android:background="@drawable/bg_chip_off" android:text="六"
                        android:textSize="13sp" android:textColor="#6B7280" android:gravity="center"/>
                    <TextView android:id="@+id/wd7"
                        android:layout_width="34dp" android:layout_height="34dp"
                        android:layout_marginLeft="6dp"
                        android:background="@drawable/bg_chip_off" android:text="日"
                        android:textSize="13sp" android:textColor="#6B7280" android:gravity="center"/>
                </LinearLayout>
                <View style="@style/FormDivider"/>

                <!-- 开始日期 -->
                <LinearLayout android:id="@+id/rowStart" style="@style/FormRow" android:paddingTop="12dp" android:paddingBottom="12dp">
                    <TextView style="@style/FormIcon" android:text="📅"/>
                    <TextView style="@style/FormLabel" android:text="开始日期"/>
                    <TextView android:id="@+id/tvStart" style="@style/FormValue" android:text="2026-09-26"/>
                    <TextView style="@style/FormArrow" android:text="›"/>
                </LinearLayout>
                <View style="@style/FormDivider"/>

                <!-- 结束日期 -->
                <LinearLayout android:id="@+id/rowEnd" style="@style/FormRow" android:paddingTop="12dp" android:paddingBottom="12dp">
                    <TextView style="@style/FormIcon" android:text="📅"/>
                    <TextView style="@style/FormLabel" android:text="结束日期"/>
                    <TextView android:id="@+id/tvEnd" style="@style/FormValue" android:text="未设置"/>
                    <TextView style="@style/FormArrow" android:text="›"/>
                </LinearLayout>
                <View style="@style/FormDivider"/>

                <!-- 提醒铃声 -->
                <LinearLayout android:id="@+id/rowSound" style="@style/FormRow" android:paddingTop="12dp" android:paddingBottom="12dp">
                    <TextView style="@style/FormIcon" android:text="🔔"/>
                    <TextView style="@style/FormLabel" android:text="提醒铃声"/>
                    <TextView android:id="@+id/tvSound" style="@style/FormValue" android:text="系统提示音"/>
                    <TextView style="@style/FormArrow" android:text="›"/>
                </LinearLayout>
            </LinearLayout>

            <!-- 底部按钮 -->
            <LinearLayout
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:orientation="horizontal">

                <TextView android:id="@+id/btnCancel"
                    android:layout_width="0dp" android:layout_height="52dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_btn_ghost"
                    android:text="取消" android:textColor="@color/blue2"
                    android:textSize="17sp" android:textStyle="bold"
                    android:gravity="center"/>

                <TextView android:id="@+id/btnSave"
                    android:layout_width="0dp" android:layout_height="52dp"
                    android:layout_weight="1" android:layout_marginLeft="14dp"
                    android:background="@drawable/bg_btn"
                    android:text="保存计划" android:textColor="#FFFFFF"
                    android:textSize="17sp" android:textStyle="bold"
                    android:gravity="center"/>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>

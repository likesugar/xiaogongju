package com.wink.pillmate;

import android.app.Notification;
import android.app.NotificationChannel;
import android.app.NotificationManager;
import android.app.Service;
import android.content.Intent;
import android.os.IBinder;

import java.io.File;

/** 链接流录制前台服务：粘贴 m3u8/mp4 链接 → ffmpeg 经本地中转后台录制，离开应用照录 */
public class LinkRecordService extends Service {

    private static final String CHANNEL = "linkrec";
    public static final String EXTRA_URL = "url";
    public static final String ACTION_STOP = "com.wink.pillmate.LINKREC_STOP";

    private volatile com.arthenica.ffmpegkit.FFmpegSession session = null;
    private volatile File outFile = null;

    @Override
    public IBinder onBind(Intent intent) { return null; }

    @Override
    public int onStartCommand(Intent intent, int flags, int startId) {
        LiveProxy.logDir = getExternalFilesDir(null);
        LiveProxy.blog("服务启动: " + (intent == null ? "restart" : String.valueOf(intent.getAction())));
        if (intent != null && ACTION_STOP.equals(intent.getAction())) {
            try { if (session != null) com.arthenica.ffmpegkit.FFmpegKit.cancel(session.getSessionId()); } catch (Throwable ignored) {}
            if (session == null) finishSave("手动停止");
            stopSelf();
            return START_NOT_STICKY;
        }
        String url = intent == null ? null : intent.getStringExtra(EXTRA_URL);
        if (url == null || url.isEmpty()) { stopSelf(); return START_NOT_STICKY; }
        startForeground(2002, buildNotification("准备录制…"));

        try {
            File dir = new File(getExternalFilesDir(null), "录制");
            dir.mkdirs();
            outFile = new File(dir, "link_" + System.currentTimeMillis() / 1000 + ".ts");
            String relay = "http://127.0.0.1:" + LiveProxy.PORT + "/relay?u="
                + java.net.URLEncoder.encode(url, "UTF-8");
            String[] args = {
                "-y", "-loglevel", "warning",
                "-reconnect", "1", "-reconnect_streamed", "1", "-reconnect_delay_max", "5",
                "-rw_timeout", "15000000",
                "-i", relay,
                "-c", "copy", "-f", "mpegts",
                outFile.getAbsolutePath()
            };
            updateNotification("录制中…");
            session = com.arthenica.ffmpegkit.FFmpegKit.executeWithArgumentsAsync(args,
                new com.arthenica.ffmpegkit.FFmpegSessionCompleteCallback() {
                    public void apply(com.arthenica.ffmpegkit.FFmpegSession s) {
                        finishSave("结束 code=" + s.getReturnCode());
                        stopSelf();
                    }
                },
                new com.arthenica.ffmpegkit.LogCallback() {
                    public void apply(com.arthenica.ffmpegkit.Log log) {
                        try {
                            java.io.FileWriter fw = new java.io.FileWriter(new File(dir, "linklog.txt"), true);
                            fw.write(log.getMessage());
                            fw.close();
                        } catch (Exception ignored) {}
                    }
                }, null);
        } catch (Throwable e) {
            finishSave("启动失败 " + e.getMessage());
            stopSelf();
        }
        return START_STICKY;
    }

    private void finishSave(String why) {
        final long sz = outFile != null && outFile.exists() ? outFile.length() : 0;
        updateNotification("已保存 " + (sz / 1048576) + " MB｜" + why);
    }

    private void updateNotification(String text) {
        NotificationManager nm = (NotificationManager) getSystemService(NOTIFICATION_SERVICE);
        nm.notify(2002, buildNotification(text));
    }

    private Notification buildNotification(String text) {
        NotificationManager nm = (NotificationManager) getSystemService(NOTIFICATION_SERVICE);
        NotificationChannel ch = new NotificationChannel(CHANNEL, "链接录制", NotificationManager.IMPORTANCE_LOW);
        nm.createNotificationChannel(ch);
        Notification.Builder b = new Notification.Builder(this, CHANNEL)
            .setSmallIcon(android.R.drawable.ic_menu_save)
            .setContentTitle("小工具 · 链接录制")
            .setContentText(text)
            .setOngoing(true);
        android.app.PendingIntent pi = android.app.PendingIntent.getService(this, 1,
            new Intent(this, LinkRecordService.class).setAction(ACTION_STOP),
            android.app.PendingIntent.FLAG_IMMUTABLE);
        b.addAction(new Notification.Action.Builder(null, "停止", pi).build());
        return b.build();
    }
}
